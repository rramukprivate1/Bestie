# Copy this file to .env (same folder) and paste your real key in.
# Same key from Google AI Studio you used for the frontend in Phase 1 -
# it now lives here instead.

GEMINI_API_KEY=paste_your_key_here

# Optional (Phase 5+): if set, voice transcription uses Groq's free Whisper
# API instead of Gemini - faster, and off Gemini's tighter rate limit
# entirely. Leave blank to keep using Gemini for transcription; nothing
# else changes either way. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Comma-separated list of frontend URLs allowed to call this backend.
# The Vite dev server default is included already - add your deployed
# frontend URL here too once you have one (Phase 2 README covers this).
CORS_ORIGINS=http://localhost:5173

# Phase 4: leave both blank to keep using local SQLite (companion.db) -
# fine for continued development. Once you have a Neon project, paste
# in both connection strings from the Neon dashboard's "Connect" modal:
# DATABASE_URL uses the pooled host (has "-pooler" in it) - the app uses
# this one at runtime. DATABASE_URL_UNPOOLED uses the direct host (no
# "-pooler") - migrations (alembic) use this one specifically, since
# Neon's connection pooler can break the DDL statements migrations issue.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
