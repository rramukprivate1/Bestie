# Backend URL - unchanged from Phase 2/3.
VITE_API_BASE_URL=http://localhost:8080

# Phase 4: Firebase config. Get these from the Firebase Console:
# your project -> Project settings (gear icon) -> scroll to "Your apps"
# -> the web app you registered -> SDK setup and configuration.
# None of these are secret in the traditional sense (see firebaseClient.js
# for why) but they're still project-specific, hence .env not hardcoded.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
